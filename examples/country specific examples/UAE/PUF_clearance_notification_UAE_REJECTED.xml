<?xml version="1.0" encoding="UTF-8"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0">

    <!--
        UAE Clearance Notification - REJECTED

        This example represents a negative (rejected) clearance response received from the
        UAE e-Invoicing system (Ministry of Finance). The source format is a Peppol Message
        Level Status (MLS) ApplicationResponse that is transformed into PUF Clearance
        Notification format.

        MLS BT mapping:
        - BT-003 (Message Identifier)          -> cbc:ID
        - BT-004 (Issue Date)                   -> cbc:IssueDate
        - BT-005 (Issue Time)                   -> cbc:IssueTime
        - BT-006/BT-007 (Sender Endpoint)      -> cac:SenderParty
        - BT-008/BT-009 (Receiver Endpoint)     -> cac:ReceiverParty
        - BT-010 (Overall response code)        -> cbc:ResponseCode (mapped to PUF codes)
        - BT-011 (Overall response description) -> cbc:Description (when present)
        - BG-001/BG-002 (Line issues)           -> cac:Status elements

        MLS issue mapping:
        - BT-013 (Issue location)               -> Included in cbc:StatusReason text
        - BT-014 (Issue description)            -> cbc:StatusReason
        - BT-015 (Issue classification)         -> cbc:StatusReasonCode

        MLS issue classification codes (BT-015):
        - BV = Business rule violation, fatal
        - BW = Business rule violation, warning
        - FD = Failure of delivery
        - SV = Syntax violation
    -->

    <!-- CustomizationID. Specification identification -->
    <cbc:CustomizationID>urn:pagero.com:puf:clearance_notification:1.0</cbc:CustomizationID>

    <!-- ProfileID. Business process type identifier -->
    <cbc:ProfileID>urn:pagero.com:puf:clearance_notification:1.0</cbc:ProfileID>

    <!-- Response identifier. Corresponds to MLS BT-003 (Message Identifier). -->
    <cbc:ID>f9e8d7c6-b5a4-3210-fedc-ba9876543210</cbc:ID>

    <!-- Issue date of the MLS response. Corresponds to MLS BT-004 (Issue Date). -->
    <cbc:IssueDate>2026-05-04</cbc:IssueDate>

    <!-- Issue time of the MLS response. Corresponds to MLS BT-005 (Issue Time). -->
    <cbc:IssueTime>09:22:45</cbc:IssueTime>

    <!-- cac:SenderParty. The UAE e-Invoicing system (MoF).
         MLS BT-006 (Sender Party Endpoint ID) and BT-007 (Scheme ID). -->
    <cac:SenderParty>
        <cbc:EndpointID schemeID="AE:TIN">1000000001</cbc:EndpointID>
        <cac:PartyName>
            <cbc:Name>UAE Ministry of Finance - e-Invoicing</cbc:Name>
        </cac:PartyName>
    </cac:SenderParty>

    <!-- cac:ReceiverParty. The taxpayer who submitted the invoice.
         MLS BT-008 (Receiver Party Endpoint ID) and BT-009 (Scheme ID). -->
    <cac:ReceiverParty>
        <cbc:EndpointID schemeID="AE:TIN">1234567890</cbc:EndpointID>
        <cac:PartyLegalEntity>
            <cbc:RegistrationName>Emirates Trading Company LLC</cbc:RegistrationName>
        </cac:PartyLegalEntity>
    </cac:ReceiverParty>

    <!-- cac:DocumentResponse. Document response -->
    <cac:DocumentResponse>

        <!-- Response information -->
        <cac:Response>

            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ResponseExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:ResponseExtension>
                                <!-- The customer's original invoice interchange id. -->
                                <puf:ReferencedDocumentInterchangeID>
                                    <cbc:ID>987654322</cbc:ID>
                                </puf:ReferencedDocumentInterchangeID>
                            </puf:ResponseExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>

            <!-- Response Code. Mapped from MLS BT-010 (Overall response code).
                 MLS "RE" (Rejected) is mapped to PUF "REJECTED".
                 Possible PUF clearance response codes:
                    APPROVED = Approved by Clearance Authority
                    REJECTED = Rejected by Clearance Authority
            -->
            <cbc:ResponseCode>REJECTED</cbc:ResponseCode>

            <!-- MLS BT-011 (Overall response description), when present. -->
            <cbc:Description>The submitted invoice was rejected due to validation errors.</cbc:Description>

            <!-- Issues from MLS BG-001/BG-002 mapped to cac:Status elements.
                 Each cac:Status represents one issue from the MLS LineResponse structure:
                 - cbc:StatusReasonCode = MLS BT-015 (Issue classification)
                 - cbc:StatusReason     = MLS BT-014 (Issue description), prefixed with BT-013 (Issue location) when available
            -->

            <!-- Issue 1: Business rule violation -->
            <cac:Status>
                <!-- StatusReasonCode from MLS BT-015 (Issue classification) -->
                <cbc:StatusReasonCode>BV</cbc:StatusReasonCode>
                <!-- StatusReason from MLS BT-014 (Issue description) with BT-013 (Issue location) -->
                <cbc:StatusReason>[/Invoice/cac:TaxTotal/cac:TaxSubtotal] Tax amount does not match the calculated value based on taxable amount and tax rate.</cbc:StatusReason>
            </cac:Status>

            <!-- Issue 2: Syntax violation -->
            <cac:Status>
                <cbc:StatusReasonCode>SV</cbc:StatusReasonCode>
                <cbc:StatusReason>[/Invoice/cac:AccountingSupplierParty/cac:Party/cac:PartyTaxScheme/cbc:CompanyID] Seller Tax Registration Number (TRN) is missing or has an invalid format.</cbc:StatusReason>
            </cac:Status>

        </cac:Response>

        <cac:DocumentReference>
            <!-- Reference to the invoice (invoice number) -->
            <cbc:ID>INV-2026-001235</cbc:ID>
            <!-- The date when the invoice was issued -->
            <cbc:IssueDate>2026-05-03</cbc:IssueDate>
            <!-- DocumentTypeCode. The invoice type code of the referenced invoice -->
            <cbc:DocumentTypeCode>380</cbc:DocumentTypeCode>
        </cac:DocumentReference>
    </cac:DocumentResponse>
</ApplicationResponse>
