<?xml version="1.0" encoding="UTF-8"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0">

    <!-- NOTE that this is an example. Track the GITHUB page for PUF to see changes and updates. -->

    <!-- Example of a tax report notification where several tax reports sent by the issuer have been
         aggregated by Pagero into one report to the authority. The authority answers with a single
         response, which is reported back to the issuer as one cac:DocumentResponse holding one
         cac:DocumentReference per tax report included in the aggregated report. -->

    <!-- CustomizationID. Specification identification -->
    <cbc:CustomizationID>urn:pagero.com:puf:taxdata_response:1.0</cbc:CustomizationID>

    <!-- ProfileID. Business process type identifier -->
    <cbc:ProfileID>urn:pagero.com:puf:taxdata_response:1.0</cbc:ProfileID>

    <!-- Response identifier. A unique id to identify the response. -->
    <cbc:ID>8c9f1d2e-4b7a-41c6-9f5e-2a0d6b3c8e14</cbc:ID>

    <!-- cbc:IssueDate -->
    <cbc:IssueDate>2026-02-16</cbc:IssueDate>

    <!-- cbc:IssueTime-->
    <cbc:IssueTime>09:12:44</cbc:IssueTime>

    <!-- cac:SenderParty. Sender information -->
    <cac:SenderParty>
        <cac:PartyName>
            <cbc:Name>PPF FRANCE</cbc:Name>
        </cac:PartyName>
    </cac:SenderParty>

    <!-- cac:ReceiverParty. Receiver information -->
    <cac:ReceiverParty>
        <cac:PartyLegalEntity>
            <cbc:RegistrationName>Seller company name</cbc:RegistrationName>
        </cac:PartyLegalEntity>
    </cac:ReceiverParty>

    <!-- cac:DocumentResponse. Document response -->
    <cac:DocumentResponse>

        <!-- Response information. The response applies to every referenced tax report below. -->
        <cac:Response>
            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ResponseExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:ResponseExtension>
                                <!-- The identifier of the aggregated report as created by Pagero.
                                     This identifier must be used when performing a rectification or
                                     replace period process for the aggregated report. -->
                                <puf:AggregatedReportID>
                                    <cbc:ID>000000000000015</cbc:ID>
                                </puf:AggregatedReportID>
                                <!-- The date and time when the aggregated report was sent to the authority -->
                                <puf:AuthorityDeliveryDateTime>2026-02-16T08:55:02.000Z</puf:AuthorityDeliveryDateTime>
                            </puf:ResponseExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>

            <!-- Response Code:
                Possible clearance response codes
                APPROVED = Approved by Clearance Authority
                REJECTED = Rejected by Clearance Authority.
            -->
            <cbc:ResponseCode>APPROVED</cbc:ResponseCode>
        </cac:Response>

        <!-- First tax report included in the aggregated report. -->
        <cac:DocumentReference>
            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:DocumentReferenceExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:DocumentReferenceExtension>
                                <!-- The interchange id or filename of the referenced tax report. If sent by the issuer -->
                                <puf:ReferencedDocumentInterchangeID>
                                    <cbc:ID>TaxReport_20260215_001.xml</cbc:ID>
                                </puf:ReferencedDocumentInterchangeID>
                                <!-- An additional identifier or name of the referenced tax report, assigned by the issuer -->
                                <puf:IssuerAssignedReportID>
                                    <cbc:ID>DailyReport-2026-02-15</cbc:ID>
                                </puf:IssuerAssignedReportID>
                            </puf:DocumentReferenceExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>
            <!-- The tax report identifier assigned by the issuer. The only identifier that can be
                 used to modify or replace the tax report later.
                 If no tax report identifier was sent by the issuer, this element will be empty. -->
            <cbc:ID>TAXREPORT001</cbc:ID>
            <!-- The date when the tax report was issued -->
            <cbc:IssueDate>2026-02-15</cbc:IssueDate>
            <!-- NOTE that cbc:DocumentTypeCode is not used for aggregated tax reports -->
        </cac:DocumentReference>

        <!-- Second tax report included in the aggregated report. -->
        <cac:DocumentReference>
            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:DocumentReferenceExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:DocumentReferenceExtension>
                                <!-- The interchange id or filename of the referenced tax report. If sent by the issuer -->
                                <puf:ReferencedDocumentInterchangeID>
                                    <cbc:ID>TaxReport_20260215_002.xml</cbc:ID>
                                </puf:ReferencedDocumentInterchangeID>
                                <!-- An additional identifier or name of the referenced tax report, assigned by the issuer -->
                                <puf:IssuerAssignedReportID>
                                    <cbc:ID>DailyReport-2026-02-15-B</cbc:ID>
                                </puf:IssuerAssignedReportID>
                            </puf:DocumentReferenceExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>
            <!-- The tax report identifier assigned by the issuer.
                 If no tax report identifier was sent by the issuer, this element will be empty. -->
            <cbc:ID>TAXREPORT002</cbc:ID>
            <!-- The date when the tax report was issued -->
            <cbc:IssueDate>2026-02-15</cbc:IssueDate>
        </cac:DocumentReference>
    </cac:DocumentResponse>
</ApplicationResponse>
