<?xml version="1.0" encoding="UTF-8"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0">

    <!--
        Slovakia Clearance/Status Notification - WITHDRAWN_SUCCESS

        This example represents the response to a withdrawal request. The previously reported
        Tax Data Document (TDD) was withdrawn, and the Financial Directorate of the Slovak
        Republic (the 5th corner / national Peppol authority) accepted the withdrawal. In the
        Peppol SK model a withdrawal is a "Disregard" TDD (type code D) that cancels the TDD
        reported earlier on the same invoice. As for any TDD, the authority answers with a
        Peppol Message Level Status (MLS) ApplicationResponse, which is transformed into the
        PUF Clearance Notification format.

        The issuer receives two clearance notifications for the same invoice:
        1. The response to the original report (see PUF_clearance_notification_Slovakia_APPROVED.xml,
           which references the same invoice and interchange id).
        2. This response, to the withdrawal of that report.

        MLS BT mapping:
        - BT-003 (Message Identifier)          -> cbc:ID
        - BT-004 (Issue Date)                   -> cbc:IssueDate
        - BT-005 (Issue Time)                   -> cbc:IssueTime
        - BT-006/BT-007 (Sender Endpoint)      -> cac:SenderParty
        - BT-008/BT-009 (Receiver Endpoint)     -> cac:ReceiverParty
        - BT-010 (Overall response code)        -> cbc:ResponseCode (accepted withdrawal request
                                                   is mapped to WITHDRAWN_SUCCESS) and the
                                                   cbc:StatusReasonCode of cac:Status (as returned)

        All identifiers, names and references are example/anonymised data.
    -->

    <!-- CustomizationID. Specification identification -->
    <cbc:CustomizationID>urn:pagero.com:puf:clearance_notification:1.0</cbc:CustomizationID>

    <!-- ProfileID. Business process type identifier -->
    <cbc:ProfileID>urn:pagero.com:puf:clearance_notification:1.0</cbc:ProfileID>

    <!-- Response identifier. Corresponds to MLS BT-003 (Message Identifier). -->
    <cbc:ID>9e4d2b71-6a3c-4d85-b1f0-3a7c5e8d2f46</cbc:ID>

    <!-- Issue date of the MLS response. Corresponds to MLS BT-004 (Issue Date). -->
    <cbc:IssueDate>2026-03-17</cbc:IssueDate>

    <!-- Issue time of the MLS response. Corresponds to MLS BT-005 (Issue Time). -->
    <cbc:IssueTime>09:12:05</cbc:IssueTime>

    <!-- cac:SenderParty. The Slovak e-invoicing/e-reporting authority (5th corner). -->
    <cac:SenderParty>
        <cac:PartyName>
            <cbc:Name>Slovak Tax Authority</cbc:Name>
        </cac:PartyName>
    </cac:SenderParty>

    <!-- cac:ReceiverParty. The taxpayer who submitted the invoice (the supplier).
         MLS BT-008 (Receiver Party Endpoint ID) and BT-009 (Scheme ID).
         Peppol EAS 0245 = Slovak tax identifier (DIC). -->
    <cac:ReceiverParty>
        <cbc:EndpointID schemeID="0245">1234567890</cbc:EndpointID>
        <cac:PartyLegalEntity>
            <cbc:RegistrationName>Dunaj Dodavatel s.r.o.</cbc:RegistrationName>
        </cac:PartyLegalEntity>
    </cac:ReceiverParty>

    <!-- cac:DocumentResponse. Document response -->
    <cac:DocumentResponse>

        <!-- Response information -->
        <cac:Response>

            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ResponseExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:ResponseExtension>
                                <!-- The customer's original invoice interchange id. -->
                                <puf:ReferencedDocumentInterchangeID>
                                    <cbc:ID>987654321</cbc:ID>
                                </puf:ReferencedDocumentInterchangeID>
                            </puf:ResponseExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>

            <!-- Response Code. Status of the withdrawal request.
                 Possible PUF clearance response codes for a withdrawal:
                    WITHDRAWN_SUCCESS = Withdrawal accepted by Clearance Authority
                    WITHDRAWN_FAILURE = Withdrawal not accepted by Clearance Authority
            -->
            <cbc:ResponseCode>WITHDRAWN_SUCCESS</cbc:ResponseCode>

            <!-- The response code returned by the authority. Corresponds to MLS BT-010 (AP = accepted). -->
            <cac:Status>
                <cbc:StatusReasonCode>AP</cbc:StatusReasonCode>
            </cac:Status>

        </cac:Response>

        <cac:DocumentReference>
            <!-- Reference to the invoice (invoice number) that was withdrawn -->
            <cbc:ID>SK-2026-00042</cbc:ID>
            <!-- The date when the invoice was issued -->
            <cbc:IssueDate>2026-03-15</cbc:IssueDate>
            <!-- DocumentTypeCode. The invoice type code of the referenced invoice -->
            <cbc:DocumentTypeCode>380</cbc:DocumentTypeCode>
        </cac:DocumentReference>
    </cac:DocumentResponse>
</ApplicationResponse>
