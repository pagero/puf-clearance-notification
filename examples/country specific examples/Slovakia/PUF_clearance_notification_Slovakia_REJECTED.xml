<?xml version="1.0" encoding="UTF-8"?>
<ApplicationResponse xmlns="urn:oasis:names:specification:ubl:schema:xsd:ApplicationResponse-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0">

    <!--
        Slovakia Clearance/Status Notification - REJECTED

        Slovakia operates a Peppol 5-corner model (mandatory B2B e-invoicing and e-reporting
        from 1 January 2027; voluntary earlier). Invoices are exchanged over the 4-corner Peppol
        network and the invoice data is reported in near real time to the Financial Directorate
        of the Slovak Republic (the 5th corner / national Peppol authority) via the IS EFA system.

        This example represents a negative acknowledgement (report/transport rejected),
        derived from a Peppol Message Level Status (MLS) ApplicationResponse and transformed
        into the PUF Clearance Notification format.

        MLS BT mapping:
        - BT-003 (Message Identifier)           -> cbc:ID
        - BT-004 (Issue Date)                    -> cbc:IssueDate
        - BT-005 (Issue Time)                    -> cbc:IssueTime
        - BT-006/BT-007 (Sender Endpoint)        -> cac:SenderParty
        - BT-008/BT-009 (Receiver Endpoint)      -> cac:ReceiverParty
        - BT-010 (Overall response code)         -> cbc:ResponseCode (MLS "RE" -> PUF "REJECTED") and the
                                                    cbc:StatusReasonCode of the first cac:Status (RE)
        - BT-011 (Overall response description)  -> cbc:StatusReason of the first cac:Status
        - BG-001/BG-002 (Issues)                 -> one further cac:Status per issue, where
                                                    cbc:StatusReason holds the issue location (BT-013),
                                                    description (BT-014) and classification (BT-015)
                                                    on separate lines

        MLS issue classification codes (BT-015), standard Peppol values:
        - BV = Business rule violation, fatal
        - BW = Business rule violation, warning
        - FD = Failure of delivery
        - SV = Syntax violation

        All identifiers, names and references are example/anonymised data.
    -->

    <!-- CustomizationID. Specification identification -->
    <cbc:CustomizationID>urn:pagero.com:puf:clearance_notification:1.0</cbc:CustomizationID>

    <!-- ProfileID. Business process type identifier -->
    <cbc:ProfileID>urn:pagero.com:puf:clearance_notification:1.0</cbc:ProfileID>

    <!-- Response identifier. Corresponds to MLS BT-003 (Message Identifier). -->
    <cbc:ID>7c2a9d4e-1b3f-4a56-8c7d-9e0f1a2b3c4d</cbc:ID>

    <!-- Issue date of the MLS response. Corresponds to MLS BT-004 (Issue Date). -->
    <cbc:IssueDate>2026-03-16</cbc:IssueDate>

    <!-- Issue time of the MLS response. Corresponds to MLS BT-005 (Issue Time). -->
    <cbc:IssueTime>08:47:33</cbc:IssueTime>

    <!-- cac:SenderParty. The Slovak e-invoicing/e-reporting authority (5th corner). -->
    <cac:SenderParty>
        <cac:PartyName>
            <cbc:Name>Slovak Tax Authority</cbc:Name>
        </cac:PartyName>
    </cac:SenderParty>

    <!-- cac:ReceiverParty. The taxpayer who submitted the invoice (the supplier).
         MLS BT-008 (Receiver Party Endpoint ID) and BT-009 (Scheme ID).
         Peppol EAS 0245 = Slovak tax identifier (DIC). -->
    <cac:ReceiverParty>
        <cbc:EndpointID schemeID="0245">1234567890</cbc:EndpointID>
        <cac:PartyLegalEntity>
            <cbc:RegistrationName>Dunaj Dodavatel s.r.o.</cbc:RegistrationName>
        </cac:PartyLegalEntity>
    </cac:ReceiverParty>

    <!-- cac:DocumentResponse. Document response -->
    <cac:DocumentResponse>

        <!-- Response information -->
        <cac:Response>

            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ResponseExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:ResponseExtension>
                                <!-- The customer's original invoice interchange id. -->
                                <puf:ReferencedDocumentInterchangeID>
                                    <cbc:ID>987654322</cbc:ID>
                                </puf:ReferencedDocumentInterchangeID>
                            </puf:ResponseExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>

            <!-- Response Code. Mapped from MLS BT-010 (Overall response code).
                 MLS "RE" (Rejected) is mapped to PUF "REJECTED".
                 Possible PUF clearance response codes:
                    APPROVED = Approved by Clearance Authority
                    APPROVED_WITH_WARNINGS = Approved by Clearance Authority with warnings
                    REJECTED = Rejected by Clearance Authority
                    WITHDRAWN_SUCCESS = Withdrawal accepted by Clearance Authority
                    WITHDRAWN_FAILURE = Withdrawal not accepted by Clearance Authority
            -->
            <cbc:ResponseCode>REJECTED</cbc:ResponseCode>

            <!-- The response code returned by the authority (MLS BT-010, RE = rejected) and the
                 overall response description (MLS BT-011), when present. -->
            <cac:Status>
                <cbc:StatusReasonCode>RE</cbc:StatusReasonCode>
                <cbc:StatusReason>The submitted invoice was rejected due to validation errors.</cbc:StatusReason>
            </cac:Status>

            <!-- Issues from MLS BG-001/BG-002, one cac:Status per issue. cbc:StatusReason holds the issue
                 location (BT-013), description (BT-014) and classification (BT-015) on separate lines. -->

            <!-- Issue 1: Business rule violation, fatal -->
            <cac:Status>
                <cbc:StatusReason>LineID: /Invoice/cac:TaxTotal/cac:TaxSubtotal
VAT category tax amount does not match the taxable amount multiplied by the VAT rate.
Reason code: BV</cbc:StatusReason>
            </cac:Status>

            <!-- Issue 2: Syntax violation -->
            <cac:Status>
                <cbc:StatusReason>LineID: /Invoice/cac:AccountingSupplierParty/cac:Party/cac:PartyTaxScheme/cbc:CompanyID
Seller VAT identifier (IC DPH) is missing or has an invalid format (expected SK followed by 10 digits).
Reason code: SV</cbc:StatusReason>
            </cac:Status>

        </cac:Response>

        <cac:DocumentReference>
            <!-- Reference to the invoice (invoice number) -->
            <cbc:ID>SK-2026-00043</cbc:ID>
            <!-- The date when the invoice was issued -->
            <cbc:IssueDate>2026-03-15</cbc:IssueDate>
            <!-- DocumentTypeCode. The invoice type code of the referenced invoice -->
            <cbc:DocumentTypeCode>380</cbc:DocumentTypeCode>
        </cac:DocumentReference>
    </cac:DocumentResponse>
</ApplicationResponse>
